@page "/MyProfile"
@model MyProfileModel
@using DiscussionBoard.Services
@{ ViewData["Title"] = "My profile"; }

<h1>My profile</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <p class="mb-1">Current avatar</p>
        <img src="@AvatarCatalog.ImagePath(Model.CurrentAvatarId)" alt="Your current avatar"
             class="rounded-circle" style="width: 64px; height: 64px; object-fit: cover;" />
    </div>

    <div class="mb-3">
        <label asp-for="Input.DisplayName" class="form-label"></label>
        <input asp-for="Input.DisplayName" class="form-control" />
        <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
    </div>

    <fieldset class="mb-3">
        <legend class="fs-6">Choose an avatar</legend>
        @foreach (var option in AvatarCatalog.Options)
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Input.AvatarId"
                       value="@option.Id" id="avatar-@option.Id" />
                <label class="form-check-label" for="avatar-@option.Id">
                    <img src="@AvatarCatalog.ImagePath(option.Id)" alt="@option.DisplayName avatar"
                         class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                    @option.DisplayName
                </label>
            </div>
        }
        <span asp-validation-for="Input.AvatarId" class="text-danger d-block"></span>
    </fieldset>

    <button type="submit" class="btn btn-primary">Save profile</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
